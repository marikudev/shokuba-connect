# Server environment for Shokuba Connect （職場コネクト).
#
# The app has NO app-owned OpenRouter key and NO access code:
# every operator uses their own OpenRouter API key, entered at
# the gate and held only in an httpOnly cookie in their browser.
# Do not add a key here — the server never reads one from the
# environment.

# LLM_MODE: "mock" for development (no real requests, dummy results),
# "openrouter" for real use. Mock is rejected in production builds.
LLM_MODE=mock

# Optional fallback model when a request carries no model choice.
# Must be one of the allowlisted ids in lib/models.ts; anything else
# is ignored in favour of the code default.
OPENROUTER_MODEL=google/gemma-4-31b-it
